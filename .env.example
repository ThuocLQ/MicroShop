# MicroShop local production-like environment sample.
# Copy this file to .env.local-prod and replace every CHANGEME value before running compose.local-prod.yml.

MICROSHOP_POSTGRES_PASSWORD=CHANGEME-postgres-password
MICROSHOP_RABBITMQ_PASSWORD=CHANGEME-rabbitmq-password
MICROSHOP_MONGO_PASSWORD=CHANGEME-mongodb-password

# Must be at least 32 bytes because IdentityService validates JWT signing keys on startup.
MICROSHOP_JWT_SECRET_KEY=CHANGEME-jwt-secret-key-at-least-32-bytes-long

# Required only when compose.local-prod.yml uses the PayPal provider. Keep these
# values in .env.local-prod or a secret manager; never commit real credentials.
MICROSHOP_PAYPAL_CLIENT_ID=CHANGEME-paypal-client-id
MICROSHOP_PAYPAL_CLIENT_SECRET=CHANGEME-paypal-client-secret
MICROSHOP_PAYPAL_WEBHOOK_ID=CHANGEME-paypal-webhook-id
MICROSHOP_PUBLIC_ORIGIN=https://shop.example.com
# Used by PaymentService webhook HMAC validation.
MICROSHOP_PAYMENT_WEBHOOK_SECRET=CHANGEME-payment-webhook-secret-at-least-32-bytes

# Optional MoMo Collection Link sandbox provider. Keep disabled for the default
# portfolio flow. When enabled, scripts/portfolio-public-up.ps1 supplies the
# required public HTTPS origin for both redirect and IPN callback URLs.
MICROSHOP_PAYMENT_PROVIDER=Sandbox
MICROSHOP_MOMO_ENABLED=false
MICROSHOP_MOMO_USE_SANDBOX=true
MICROSHOP_MOMO_PARTNER_CODE=SET_BY_ENVIRONMENT
MICROSHOP_MOMO_ACCESS_KEY=SET_BY_ENVIRONMENT
MICROSHOP_MOMO_SECRET_KEY=SET_BY_ENVIRONMENT

# Protects internal service-to-service endpoints from direct public calls.
MICROSHOP_INTERNAL_API_KEY=CHANGEME-internal-api-key-at-least-32-bytes

# First administrator for a new Identity database. These values are only used to
# create the account when it does not already exist; choose a unique password.
MICROSHOP_BOOTSTRAP_ADMIN_USERNAME=CHANGEME-admin-username
MICROSHOP_BOOTSTRAP_ADMIN_PASSWORD=CHANGEME-admin-password-at-least-14-characters

# Keep this aligned with MICROSHOP_MONGO_PASSWORD.
# URL-encode special characters if the password contains symbols reserved by MongoDB URLs.
MICROSHOP_MONGODB_CONNECTION_STRING=mongodb://microshop:CHANGEME-mongodb-password@mongodb:27017/?authSource=admin
