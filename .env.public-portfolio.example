# Copy to .env.public-portfolio. This file is ignored; never commit the tunnel token.
# FreeDomain delegates nameservers only. Create the DNS zone in Cloudflare first,
# then use the exact public hostname below for both values.
MICROSHOP_STOREFRONT_PUBLIC_ORIGIN=https://shop.example.domain
MICROSHOP_PUBLIC_ORIGIN=https://shop.example.domain

# Pin a reviewed cloudflared image digest, not :latest.
MICROSHOP_CLOUDFLARED_IMAGE=cloudflare/cloudflared:REPLACE_WITH_REVIEWED_VERSION@sha256:REPLACE_WITH_DIGEST
MICROSHOP_CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_NAMED_TUNNEL_TOKEN