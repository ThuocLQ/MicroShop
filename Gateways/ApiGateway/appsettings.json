{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "AllowedCorsOrigins": [
      "https://localhost:7001",
      "http://localhost:5027"
    ],
    "BlockDebugRoutesOutsideDevelopment": true,
    "BlockInternalRoutesOutsideDevelopment": true,
    "AuthPermitLimit": 20,
    "GeneralPermitLimit": 120,
    "WebhookPermitLimit": 60,
    "HealthPermitLimit": 600,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/catalog"
          },
          {
            "ResponseHeader": "X-Gateway",
            "Set": "YARP"
          }
        ]
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/inventory/{**catch-all}"
        },
        "Transforms": [
          {
            "ResponseHeader": "X-Gateway",
            "Set": "YARP"
          }
        ]
      },
      "basket-route": {
        "ClusterId": "basket-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/cart/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/basket/{**catch-all}"
          },
          {
            "ResponseHeader": "X-Gateway",
            "Set": "YARP"
          }
        ]
      },
      "ordering-route": {
        "ClusterId": "ordering-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "ResponseHeader": "X-Gateway",
            "Set": "YARP"
          }
        ]
      },
      "order-summary-root-route": {
        "ClusterId": "order-query-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/order-summaries"
        },
        "Transforms": [
          {
            "ResponseHeader": "X-Gateway",
            "Set": "YARP"
          }
        ]
      },
      "order-summary-route": {
        "ClusterId": "order-query-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/order-summaries/{**catch-all}"
        },
        "Transforms": [
          {
            "ResponseHeader": "X-Gateway",
            "Set": "YARP"
          }
        ]
      },
      "order-summary-debug-root-route": {
        "ClusterId": "order-query-cluster",
        "Match": {
          "Path": "/debug/order-summaries"
        },
        "Transforms": [
          {
            "ResponseHeader": "X-Gateway",
            "Set": "YARP"
          }
        ]
      },
      "order-summary-debug-route": {
        "ClusterId": "order-query-cluster",
        "Match": {
          "Path": "/debug/order-summaries/{**catch-all}"
        },
        "Transforms": [
          {
            "ResponseHeader": "X-Gateway",
            "Set": "YARP"
          }
        ]
      },
      "discount-route": {
        "ClusterId": "discount-cluster",
        "Match": {
          "Path": "/discounts/{**catch-all}"
        },
        "Transforms": [
          {
            "ResponseHeader": "X-Gateway",
            "Set": "YARP"
          }
        ]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "ResponseHeader": "X-Gateway",
            "Set": "YARP"
          }
        ]
      },
      "account-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/me/{**catch-all}"
        },
        "Transforms": [
          {
            "ResponseHeader": "X-Gateway",
            "Set": "YARP"
          }
        ]
      },
      "supplier-route": {
        "ClusterId": "supplier-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/suppliers/{**catch-all}"
        },
        "Transforms": [
          {
            "ResponseHeader": "X-Gateway",
            "Set": "YARP"
          }
        ]
      },
      "procurement-route": {
        "ClusterId": "supplier-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/procurement/{**catch-all}"
        },
        "Transforms": [
          {
            "ResponseHeader": "X-Gateway",
            "Set": "YARP"
          }
        ]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/payments/{**catch-all}"
        },
        "Transforms": [
          {
            "ResponseHeader": "X-Gateway",
            "Set": "YARP"
          }
        ]
      },
      "payment-webhook-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/webhooks/{**catch-all}"
        },
        "Transforms": [
          {
            "ResponseHeader": "X-Gateway",
            "Set": "YARP"
          }
        ]
      },
      "realtime-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/realtime/{**catch-all}"
        },
        "Transforms": [
          {
            "ResponseHeader": "X-Gateway",
            "Set": "YARP"
          }
        ]
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog-destination": {
            "Address": "https://localhost:7002/"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "inventory-destination": {
            "Address": "https://localhost:7009/"
          }
        }
      },
      "basket-cluster": {
        "Destinations": {
          "basket-destination": {
            "Address": "https://localhost:7003/"
          }
        }
      },
      "ordering-cluster": {
        "Destinations": {
          "ordering-destination": {
            "Address": "https://localhost:7005/"
          }
        }
      },
      "order-query-cluster": {
        "Destinations": {
          "order-query-destination": {
            "Address": "https://localhost:7008/"
          }
        }
      },
      "discount-cluster": {
        "Destinations": {
          "discount-destination": {
            "Address": "https://localhost:7006/"
          }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "identity-destination": {
            "Address": "https://localhost:7004/"
          }
        }
      },
      "supplier-cluster": {
        "Destinations": {
          "supplier-destination": {
            "Address": "https://localhost:7010/"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-destination": {
            "Address": "https://localhost:7007/"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-destination": {
            "Address": "https://localhost:7011/"
          }
        }
      }
    }
  }
}