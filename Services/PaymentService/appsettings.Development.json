{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "MicroShop.IdentityService",
    "Audience": "MicroShop.Client",
    "SecretKey": "microshop-development-secret-key-must-be-long-enough"
  },
  "ConnectionStrings": {
    "PaymentDb": "Host=localhost;Port=5432;Database=paymentdb;Username=microshop;Password=microshop"
  },
  "ServiceUrls": {
    "OrderingHttp": "https://localhost:7005"
  },
  "InternalApi": {
    "Key": "microshop-development-internal-api-key"
  },
  "PaymentWebhooks": {
    "SignatureHeaderName": "X-MicroShop-Signature",
    "SharedSecret": "dev-webhook-secret",
    "RequireSignature": true
  },
  "PaymentProvider": {
    "Provider": "CashOnDelivery",
    "EnabledProviders": [ "CashOnDelivery", "Sandbox" ],
    "AllowSandbox": true,
    "SandboxActionExpiryMinutes": 30
  },
  "PaymentOutboxDispatcher": {
    "Enabled": true,
    "BatchSize": 20,
    "IntervalSeconds": 5,
    "MaxRetryCount": 10,
    "LockSeconds": 60,
    "RetryDelaySeconds": 15,
    "MaxRetryDelaySeconds": 300
  }
}
