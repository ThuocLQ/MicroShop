{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "MicroShop.IdentityService",
    "Audience": "MicroShop.Client",
    "SecretKey": "SET_BY_ENVIRONMENT"
  },
  "ConnectionStrings": {
    "PaymentDb": "Host=localhost;Port=5432;Database=paymentdb;Username=microshop;Password=microshop"
  },
  "ServiceUrls": {
    "OrderingHttp": "https://localhost:7005"
  },
  "InternalApi": {
    "Key": "SET_BY_ENVIRONMENT"
  },
  "PaymentWebhooks": {
    "SignatureHeaderName": "X-MicroShop-Signature",
    "SharedSecret": "SET_BY_ENVIRONMENT",
    "RequireSignature": true
  },
  "PaymentProvider": {
    "Provider": "PayPal",
    "EnabledProviders": [ "PayPal" ],
    "SandboxActionExpiryMinutes": 30,
    "PayPal": {
      "Enabled": false,
      "UseSandbox": true,
      "ClientId": "SET_BY_ENVIRONMENT",
      "ClientSecret": "SET_BY_ENVIRONMENT",
      "WebhookId": "SET_BY_ENVIRONMENT",
      "ReturnUrl": "https://shop.example.com/payment/return",
      "CancelUrl": "https://shop.example.com/payment/cancel",
      "ActionExpiryMinutes": 30
    },
    "MoMo": {
      "Enabled": false,
      "UseSandbox": true,
      "PartnerCode": "SET_BY_ENVIRONMENT",
      "AccessKey": "SET_BY_ENVIRONMENT",
      "SecretKey": "SET_BY_ENVIRONMENT",
      "RedirectUrl": "https://shop.example.com/payment/return",
      "IpnUrl": "https://api.example.com/webhooks/momo",
      "ActionExpiryMinutes": 30
    }
  },
  "PaymentOutboxDispatcher": {
    "Enabled": true,
    "BatchSize": 20,
    "IntervalSeconds": 5,
    "MaxRetryCount": 10,
    "LockSeconds": 60,
    "RetryDelaySeconds": 15,
    "MaxRetryDelaySeconds": 300
  }
}
