{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "UserName": "microshop",
    "Password": "microshop"
  },
  "ConnectionStrings": {
    "NotificationDb": "Host=localhost;Port=5432;Database=notificationdb;Username=microshop;Password=microshop"
  },
  "Messaging": {
    "Retry": {
      "RetryCount": 3,
      "IntervalSeconds": 2
    }
  },
  "NotificationDeliveryRecovery": {
    "ScanIntervalSeconds": 10,
    "FailureGraceSeconds": 10
  },
  "NotificationDelivery": {
    "Mode": "Logging",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "UserName": "",
      "Password": "",
      "FromAddress": "",
      "FromDisplayName": "MicroShop",
      "PublicStorefrontBaseUrl": "http://localhost:5027"
    }
  },
  "Jwt": {
    "Issuer": "MicroShop.IdentityService",
    "Audience": "MicroShop.Client",
    "SecretKey": "microshop-development-secret-key-must-be-long-enough"
  }
}